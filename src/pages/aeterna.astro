<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Æterna — Knowledge Search for European Teams</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link
            href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap"
            rel="stylesheet"
        />
        <style>
            *,
            *::before,
            *::after {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --bg: #000;
                --fg: #ededed;
                --fg-muted: #888;
                --fg-faint: #444;
                --border: #1a1a1a;
                --border-mid: #2e2e2e;
                --surface: #0a0a0a;
                --surface-mid: #111;
                --accent: #fff;
                --blue: #3291ff;
                --blue-dim: rgba(50, 145, 255, 0.15);
                --radius: 8px;
                --mono: "Geist Mono", "Menlo", monospace;
                --sans: "DM Sans", -apple-system, sans-serif;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: var(--sans);
                background: var(--bg);
                color: var(--fg);
                line-height: 1.6;
                -webkit-font-smoothing: antialiased;
                overflow-x: hidden;
            }

            /* ─── GRID BACKGROUND ─── */
            body::before {
                content: "";
                position: fixed;
                inset: 0;
                background-image:
                    linear-gradient(var(--border) 1px, transparent 1px),
                    linear-gradient(90deg, var(--border) 1px, transparent 1px);
                background-size: 64px 64px;
                mask-image: radial-gradient(
                    ellipse 80% 60% at 50% 0%,
                    black 30%,
                    transparent 80%
                );
                z-index: 0;
                pointer-events: none;
            }

            /* ─── NAVBAR ─── */
            nav {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                z-index: 100;
                border-bottom: 1px solid var(--border);
                background: rgba(0, 0, 0, 0.7);
                backdrop-filter: blur(16px) saturate(180%);
                height: 56px;
                display: flex;
                align-items: center;
            }

            .nav-inner {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 24px;
                width: 100%;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .nav-left {
                display: flex;
                align-items: center;
                gap: 32px;
            }

            .logo {
                font-family: var(--mono);
                font-size: 15px;
                font-weight: 500;
                color: var(--fg);
                letter-spacing: -0.01em;
                display: flex;
                align-items: center;
                gap: 10px;
            }

            .logo-mark {
                width: 22px;
                height: 22px;
                background: var(--fg);
                border-radius: 4px;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .logo-mark svg {
                width: 14px;
                height: 14px;
                fill: var(--bg);
            }

            .nav-links {
                display: flex;
                gap: 0;
                align-items: center;
            }

            .nav-links a {
                color: var(--fg-muted);
                text-decoration: none;
                font-size: 14px;
                padding: 4px 12px;
                border-radius: 6px;
                transition:
                    color 0.15s,
                    background 0.15s;
            }

            .nav-links a:hover {
                color: var(--fg);
                background: rgba(255, 255, 255, 0.05);
            }

            .nav-right {
                display: flex;
                gap: 8px;
                align-items: center;
            }

            .btn {
                font-family: var(--sans);
                font-size: 13px;
                font-weight: 500;
                padding: 6px 14px;
                border-radius: 6px;
                text-decoration: none;
                cursor: pointer;
                transition: all 0.15s;
                display: inline-flex;
                align-items: center;
                gap: 6px;
                letter-spacing: -0.01em;
                border: none;
            }

            .btn-ghost {
                color: var(--fg-muted);
                background: transparent;
            }
            .btn-ghost:hover {
                color: var(--fg);
                background: rgba(255, 255, 255, 0.05);
            }

            .btn-outline {
                color: var(--fg);
                background: transparent;
                border: 1px solid var(--border-mid);
            }
            .btn-outline:hover {
                border-color: #555;
                background: rgba(255, 255, 255, 0.03);
            }

            .btn-primary {
                color: var(--bg);
                background: var(--fg);
            }
            .btn-primary:hover {
                background: #e0e0e0;
            }

            /* ─── HERO ─── */
            .hero {
                position: relative;
                z-index: 1;
                padding: 160px 24px 120px;
                max-width: 1200px;
                margin: 0 auto;
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
            }

            /* Radial glow */
            .hero::after {
                content: "";
                position: absolute;
                top: 80px;
                left: 50%;
                transform: translateX(-50%);
                width: 700px;
                height: 400px;
                background: radial-gradient(
                    ellipse,
                    rgba(50, 145, 255, 0.12) 0%,
                    transparent 65%
                );
                pointer-events: none;
                z-index: -1;
            }

            .hero-badge {
                font-family: var(--mono);
                font-size: 11px;
                letter-spacing: 0.06em;
                color: var(--fg-muted);
                border: 1px solid var(--border-mid);
                border-radius: 999px;
                padding: 5px 14px;
                margin-bottom: 32px;
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: rgba(255, 255, 255, 0.02);
                animation: fadeUp 0.5s ease both 0.1s;
            }

            .badge-dot {
                width: 6px;
                height: 6px;
                background: var(--blue);
                border-radius: 50%;
                box-shadow: 0 0 8px var(--blue);
                animation: pulse 2s ease infinite;
            }

            @keyframes pulse {
                0%,
                100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0.4;
                }
            }

            .hero h1 {
                font-family: var(--sans);
                font-size: clamp(40px, 6vw, 76px);
                font-weight: 300;
                line-height: 1.05;
                letter-spacing: -0.04em;
                margin-bottom: 24px;
                animation: fadeUp 0.5s ease both 0.2s;
                color: var(--fg);
            }

            .hero h1 em {
                font-style: normal;
                color: var(--fg-muted);
            }

            .hero-sub {
                font-size: 17px;
                color: var(--fg-muted);
                font-weight: 300;
                max-width: 560px;
                line-height: 1.65;
                margin-bottom: 40px;
                animation: fadeUp 0.5s ease both 0.3s;
                letter-spacing: -0.01em;
            }

            .hero-actions {
                display: flex;
                gap: 10px;
                align-items: center;
                animation: fadeUp 0.5s ease both 0.4s;
            }

            .hero-actions .btn {
                padding: 10px 20px;
                font-size: 14px;
            }

            .hero-actions .btn-primary {
                box-shadow:
                    0 0 0 1px rgba(255, 255, 255, 0.15),
                    0 4px 24px rgba(255, 255, 255, 0.06);
            }

            @keyframes fadeUp {
                from {
                    opacity: 0;
                    transform: translateY(16px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            /* ─── METRICS STRIP ─── */
            .metrics {
                position: relative;
                z-index: 1;
                border-top: 1px solid var(--border);
                border-bottom: 1px solid var(--border);
            }

            .metrics-inner {
                max-width: 1200px;
                margin: 0 auto;
                padding: 0 24px;
                display: grid;
                grid-template-columns: repeat(4, 1fr);
            }

            .metric {
                padding: 40px 32px;
                border-right: 1px solid var(--border);
                transition: background 0.2s;
            }

            .metric:last-child {
                border-right: none;
            }
            .metric:hover {
                background: rgba(255, 255, 255, 0.02);
            }

            .metric-val {
                font-family: var(--mono);
                font-size: 28px;
                font-weight: 400;
                color: var(--fg);
                letter-spacing: -0.03em;
                margin-bottom: 6px;
            }

            .metric-val span {
                color: var(--blue);
            }

            .metric-label {
                font-size: 13px;
                color: var(--fg-muted);
                letter-spacing: -0.01em;
            }

            /* ─── SECTION COMMON ─── */
            section {
                position: relative;
                z-index: 1;
            }

            .section-wrap {
                max-width: 1200px;
                margin: 0 auto;
                padding: 120px 24px;
            }

            .section-eyebrow {
                font-family: var(--mono);
                font-size: 11px;
                letter-spacing: 0.08em;
                color: var(--fg-faint);
                text-transform: uppercase;
                margin-bottom: 16px;
            }

            .section-title {
                font-size: clamp(28px, 4vw, 48px);
                font-weight: 300;
                letter-spacing: -0.035em;
                line-height: 1.1;
                margin-bottom: 16px;
            }

            .section-body {
                font-size: 16px;
                color: var(--fg-muted);
                font-weight: 300;
                line-height: 1.7;
                max-width: 560px;
                letter-spacing: -0.01em;
            }

            /* ─── FEATURE GRID ─── */
            .feature-header {
                max-width: 640px;
                margin-bottom: 64px;
            }

            .features {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                border: 1px solid var(--border);
                border-radius: 12px;
                overflow: hidden;
            }

            .feat {
                padding: 40px;
                border-bottom: 1px solid var(--border);
                border-right: 1px solid var(--border);
                transition: background 0.2s;
                position: relative;
            }

            .feat:nth-child(2n) {
                border-right: none;
            }
            .feat:nth-child(3),
            .feat:nth-child(4) {
                border-bottom: none;
            }
            .feat:hover {
                background: rgba(255, 255, 255, 0.015);
            }

            .feat::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 1px;
                background: linear-gradient(
                    90deg,
                    transparent,
                    var(--blue),
                    transparent
                );
                opacity: 0;
                transition: opacity 0.3s;
            }

            .feat:hover::before {
                opacity: 1;
            }

            .feat-icon {
                width: 36px;
                height: 36px;
                border: 1px solid var(--border-mid);
                border-radius: 8px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 20px;
                background: var(--surface-mid);
            }

            .feat-icon svg {
                width: 16px;
                height: 16px;
                stroke: var(--fg-muted);
            }

            .feat h3 {
                font-family: var(--sans);
                font-size: 15px;
                font-weight: 500;
                letter-spacing: -0.02em;
                margin-bottom: 10px;
                color: var(--fg);
            }

            .feat p {
                font-size: 14px;
                color: var(--fg-muted);
                line-height: 1.65;
                font-weight: 300;
            }

            .feat-link {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                margin-top: 16px;
                font-size: 13px;
                color: var(--blue);
                text-decoration: none;
                font-family: var(--mono);
                letter-spacing: -0.01em;
                transition: gap 0.2s;
            }

            .feat-link:hover {
                gap: 10px;
            }

            /* ─── COMPARISON ─── */
            .compare-header {
                margin-bottom: 48px;
            }

            .compare-table {
                border: 1px solid var(--border);
                border-radius: 12px;
                overflow: hidden;
            }

            .compare-row {
                display: grid;
                grid-template-columns: 2fr 1.5fr 1.5fr 1.5fr;
                border-bottom: 1px solid var(--border);
                transition: background 0.15s;
            }

            .compare-row:last-child {
                border-bottom: none;
            }
            .compare-row:not(.compare-head):hover {
                background: rgba(255, 255, 255, 0.015);
            }

            .compare-head {
                background: var(--surface-mid);
            }

            .compare-cell {
                padding: 18px 24px;
                font-size: 13px;
                color: var(--fg-muted);
                border-right: 1px solid var(--border);
                display: flex;
                align-items: center;
            }

            .compare-cell:last-child {
                border-right: none;
            }

            .compare-head .compare-cell {
                font-family: var(--mono);
                font-size: 11px;
                letter-spacing: 0.04em;
                color: var(--fg-faint);
                padding: 14px 24px;
            }

            .compare-head .compare-cell:first-child {
                color: var(--fg-muted);
                font-size: 12px;
            }

            .compare-cell.aeterna {
                color: var(--fg);
                font-weight: 500;
            }

            .yes {
                color: #22c55e;
                font-family: var(--mono);
                font-size: 12px;
            }
            .no {
                color: var(--fg-faint);
                font-family: var(--mono);
                font-size: 12px;
            }
            .partial {
                color: #f59e0b;
                font-family: var(--mono);
                font-size: 12px;
            }

            /* ─── COMPLIANCE BANNER ─── */
            .compliance-wrap {
                border: 1px solid var(--border);
                border-radius: 12px;
                background: var(--surface);
                overflow: hidden;
                position: relative;
            }

            .compliance-bg {
                position: absolute;
                inset: 0;
                background:
                    radial-gradient(
                        ellipse 60% 60% at 80% 50%,
                        rgba(50, 145, 255, 0.08) 0%,
                        transparent 60%
                    ),
                    linear-gradient(
                        90deg,
                        transparent 40%,
                        rgba(50, 145, 255, 0.04) 100%
                    );
                pointer-events: none;
            }

            .compliance-inner {
                position: relative;
                z-index: 1;
                padding: 64px 56px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 48px;
                align-items: center;
            }

            .compliance-tag {
                font-family: var(--mono);
                font-size: 11px;
                letter-spacing: 0.08em;
                color: var(--blue);
                background: var(--blue-dim);
                border: 1px solid rgba(50, 145, 255, 0.25);
                padding: 4px 12px;
                border-radius: 999px;
                display: inline-block;
                margin-bottom: 20px;
            }

            .compliance-title {
                font-size: clamp(24px, 3vw, 38px);
                font-weight: 300;
                letter-spacing: -0.035em;
                line-height: 1.15;
                margin-bottom: 16px;
            }

            .compliance-body {
                font-size: 15px;
                color: var(--fg-muted);
                font-weight: 300;
                line-height: 1.65;
            }

            .compliance-list {
                list-style: none;
                display: flex;
                flex-direction: column;
                gap: 14px;
            }

            .compliance-list li {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                font-size: 14px;
                color: var(--fg-muted);
            }

            .compliance-list li::before {
                content: "✓";
                color: var(--blue);
                font-family: var(--mono);
                font-size: 12px;
                margin-top: 2px;
                flex-shrink: 0;
            }

            /* ─── QUOTE ─── */
            .quote-section {
                border-top: 1px solid var(--border);
                border-bottom: 1px solid var(--border);
            }

            .quote-inner {
                max-width: 1200px;
                margin: 0 auto;
                padding: 80px 24px;
                display: flex;
                gap: 48px;
                align-items: flex-start;
            }

            .quote-mark {
                font-family: var(--mono);
                font-size: 48px;
                color: var(--fg-faint);
                line-height: 1;
                flex-shrink: 0;
                margin-top: -8px;
            }

            .quote-text {
                font-size: clamp(18px, 2.5vw, 26px);
                font-weight: 300;
                letter-spacing: -0.025em;
                line-height: 1.45;
                color: var(--fg);
                margin-bottom: 20px;
            }

            .quote-attribution {
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .quote-avatar {
                width: 28px;
                height: 28px;
                border-radius: 50%;
                background: linear-gradient(135deg, #333, #555);
                border: 1px solid var(--border-mid);
            }

            .quote-name {
                font-size: 13px;
                color: var(--fg-muted);
                font-family: var(--mono);
            }

            /* ─── FOOTER ─── */
            footer {
                position: relative;
                z-index: 1;
                border-top: 1px solid var(--border);
            }

            .footer-main {
                max-width: 1200px;
                margin: 0 auto;
                padding: 56px 24px 40px;
                display: grid;
                grid-template-columns: 2fr 1fr 1fr 1fr;
                gap: 40px;
            }

            .footer-logo {
                font-family: var(--mono);
                font-size: 14px;
                color: var(--fg);
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                gap: 8px;
            }

            .footer-desc {
                font-size: 13px;
                color: var(--fg-faint);
                line-height: 1.6;
                max-width: 220px;
            }

            .footer-col h4 {
                font-family: var(--mono);
                font-size: 11px;
                letter-spacing: 0.06em;
                color: var(--fg-faint);
                text-transform: uppercase;
                margin-bottom: 16px;
            }

            .footer-col ul {
                list-style: none;
            }
            .footer-col ul li {
                margin-bottom: 10px;
            }

            .footer-col ul a {
                font-size: 13px;
                color: var(--fg-muted);
                text-decoration: none;
                transition: color 0.15s;
                letter-spacing: -0.01em;
            }

            .footer-col ul a:hover {
                color: var(--fg);
            }

            .footer-bottom {
                max-width: 1200px;
                margin: 0 auto;
                padding: 20px 24px;
                border-top: 1px solid var(--border);
                display: flex;
                justify-content: space-between;
                align-items: center;
            }

            .footer-bottom-left {
                font-family: var(--mono);
                font-size: 12px;
                color: var(--fg-faint);
            }

            .footer-bottom-right {
                display: flex;
                gap: 24px;
            }

            .footer-bottom-right a {
                font-size: 12px;
                color: var(--fg-faint);
                text-decoration: none;
                transition: color 0.15s;
            }

            .footer-bottom-right a:hover {
                color: var(--fg-muted);
            }

            /* ─── STATUS INDICATOR ─── */
            .status-pill {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-family: var(--mono);
                font-size: 11px;
                color: #22c55e;
                border: 1px solid rgba(34, 197, 94, 0.2);
                background: rgba(34, 197, 94, 0.06);
                padding: 4px 10px;
                border-radius: 999px;
            }

            .status-dot {
                width: 5px;
                height: 5px;
                background: #22c55e;
                border-radius: 50%;
                animation: pulse 2s infinite;
            }

            /* ─── RESPONSIVE ─── */
            @media (max-width: 900px) {
                .metrics-inner {
                    grid-template-columns: repeat(2, 1fr);
                }
                .metric:nth-child(2) {
                    border-right: none;
                }
                .metric:nth-child(3) {
                    border-right: 1px solid var(--border);
                }
                .metric:nth-child(3),
                .metric:nth-child(4) {
                    border-top: 1px solid var(--border);
                }
                .features {
                    grid-template-columns: 1fr;
                }
                .feat:nth-child(2n) {
                    border-right: 1px solid var(--border);
                }
                .feat:nth-child(3) {
                    border-bottom: 1px solid var(--border);
                }
                .feat:nth-child(4) {
                    border-bottom: none;
                }
                .feat {
                    border-right: none !important;
                }
                .compare-row {
                    grid-template-columns: 1fr 1fr;
                }
                .compare-cell:nth-child(3),
                .compare-cell:nth-child(4) {
                    display: none;
                }
                .compliance-inner {
                    grid-template-columns: 1fr;
                    padding: 40px 32px;
                }
                .footer-main {
                    grid-template-columns: 1fr 1fr;
                }
                .quote-inner {
                    flex-direction: column;
                    gap: 24px;
                }
            }

            @media (max-width: 600px) {
                .nav-links {
                    display: none;
                }
                .hero h1 {
                    font-size: 36px;
                }
                .metrics-inner {
                    grid-template-columns: 1fr 1fr;
                }
                .footer-main {
                    grid-template-columns: 1fr;
                }
            }
        </style>
    </head>
    <body>
        <!-- NAV -->
        <nav>
            <div class="nav-inner">
                <div class="nav-left">
                    <div class="logo">
                        <div class="logo-mark">
                            <svg viewBox="0 0 14 14"
                                ><path d="M7 1 L13 13 L1 13 Z"></path></svg
                            >
                        </div>
                        Æterna
                    </div>
                    <div class="nav-links">
                        <a href="#product">Product</a>
                        <a href="#compare">Compare</a>
                        <a href="#compliance">Compliance</a>
                        <a href="#">Docs</a>
                    </div>
                </div>
                <div class="nav-right">
                    <a href="#" class="btn btn-ghost">Log in</a>
                    <a href="#" class="btn btn-outline">Talk to us</a>
                    <a href="#" class="btn btn-primary">Request demo →</a>
                </div>
            </div>
        </nav>

        <!-- HERO -->
        <div class="hero">
            <div class="hero-badge">
                <span class="badge-dot"></span>
                DORA · NIS2 · EU Data Act · Cloud &amp; AI Act — compliant by design
            </div>
            <h1>
                Your team's knowledge<br /><em>shouldn't live in silos.</em>
            </h1>
            <p class="hero-sub">
                Æterna is a European AI platform that connects your tools,
                surfaces answers in context, and keeps every byte of your data
                inside the EU — with no vendor lock-in.
            </p>
            <div class="hero-actions">
                <a href="#" class="btn btn-primary">Request demo →</a>
                <a href="#" class="btn btn-outline">See how it works</a>
            </div>
        </div>

        <!-- METRICS -->
        <div class="metrics">
            <div class="metrics-inner">
                <div class="metric">
                    <div class="metric-val"><span>2</span>hrs</div>
                    <div class="metric-label">
                        saved per employee daily on knowledge search
                    </div>
                </div>
                <div class="metric">
                    <div class="metric-val"><span>660</span>%</div>
