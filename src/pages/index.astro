---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <section class="container post-content">
    <div class="row">
      <div class="col-12 col-xl-12">
        <header class="row align-items-center">
          <h1 class="emphasis mb-0">John Choque</h1>
        </header>
        <section>
          <p class="subtitle">
            Building for digital sovereignty and a post-extractive web
          </p>
          <p>
            I build interfaces with the conviction that how we design technology
            determines who gets to be free. From healthcare platforms to civic
            infrastructure, and toward a web where communities hold their own
            knowledge, identity, and future.
          </p>
          <p>
            Throughout my career I have explored software as a means towards the
            idea that any technology only has value if it genuinely contributes
            to the wellbeing of all people and to life on earth. My work falls
            into the categories of AI ethics, data sovereignty, digital
            inclusion, edtech, and the infrastructure communities need to be
            genuinely self-determined.
          </p>
          <p>
            I am currently a Frontend Engineer at
            <a href="https://www.livahealthcare.com/" target="_blank"
              >Liva Healthcare</a
            >. Prior to this role, I co-founded multiple organizations and
            startups, and volunteered with several mission-driven initiatives.
            You can see all
            <a href="/workbench">my previous projects here</a>.
          </p>
        </section>
      </div>
    </div>
  </section>
</BaseLayout>
